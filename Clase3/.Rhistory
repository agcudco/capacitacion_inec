trim_ws = FALSE,
locale = readr::locale(encoding = "UTF-8"),
show_col_types = FALSE
)
# PASO 0.5 · Verificación inicial (no es aún un certificado de calidad).
dim(datos)             # Esperado: 1500 filas y 27 columnas
names(datos)           # Revisar encabezados
head(datos, 5)         # Primeros cinco registros
readr::problems(datos) # Puede dar 0 problemas aunque haya datos incorrectos.
# PASO 0.6 · Funciones reutilizables para ausencias y números.
# La ausencia es un concepto distinto de un valor numérico 0.
es_ausente <- function(x) {
texto <- toupper(trimws(as.character(x)))
is.na(texto) | texto %in% c("", "NA", "N/D", "SIN DATO")
}
# Conversión conservadora: no convierte silenciosamente textos como '1.250,50'.
# Las advertencias de conversión se investigarán en el módulo 3.
numero_estricto <- function(x) {
suppressWarnings(readr::parse_double(
x,
na = c("", "NA", "N/D", "SIN DATO"),
locale = readr::locale(decimal_mark = ".")
))
}
es_ausente(c(NA,"","NA","N/D","SIN DATO"))
es_ausente(c(NA,"","NA","N/D","SIN DATO","0","0.00"))
test <-c("150","25.5","0.75","","NA","N/D","SIN DATO","abc","1,500","-25.5")
result_test<-numero_estricto(test)
result_test<-numero_estricto(test)
numero_estricto(c("150","25.5","0.75","","NA","N/D","SIN DATO","abc","1,500","-25.5"))
View(datos)
#buscar las ausencias en edad
sum(is.na(datos$edad))
sum(trimws(datos$edad)=="",na.rm=TRUE)
sum(es_ausente(datos$edad))
porcentaje_edad<-round(
100*sum(es_ausente(datos$edad))/nrow(datos)
,2)
print(porcentaje_edad)
# PASO 3.1 · Recuento total de ausencias, columna por columna.
tabla_ausencias <- tibble::tibble(
variable = names(datos),
n_ausentes = vapply(datos, function(x) sum(es_ausente(x)), integer(1))
) %>%
dplyr::mutate(
porcentaje = round(100 * n_ausentes / nrow(datos), 2)
) %>%
dplyr::arrange(dplyr::desc(n_ausentes))
print(tabla_ausencias, n = 27)
# PASO 3.2 · Gráfico de barras de ausencias (se excluye el campo libre opcional).
g_ausencias <- tabla_ausencias %>%
dplyr::filter(variable != "observaciones", n_ausentes > 0) %>%
ggplot2::ggplot(ggplot2::aes(
x = stats::reorder(variable, n_ausentes), y = n_ausentes
)) +
ggplot2::geom_col(fill = "#14679E") +
ggplot2::coord_flip() +
ggplot2::labs(
title = "Ausencias declaradas por variable",
subtitle = "CSV sintético · 1.500 registros · no implica error automático",
x = NULL, y = "Número de ausencias"
) +
ggplot2::theme_minimal()
print(g_ausencias)
# OPCIONAL DESPUÉS DE REVISAR:
ggplot2::ggsave(here::here("resultados", "m3_ausencias.png"), g_ausencias, width=10, height=6)
