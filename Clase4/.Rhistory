valor_propuesto = b[indices],
regla_id = rep(codigo_regla, length(indices)),
version_regla = rep("1.0", length(indices)),
justificacion = rep("Equivalencia definida en diccionario didáctico", length(indices)),
tipo_accion = rep("NORMALIZACION_PROPUESTA", length(indices)),
responsable = rep("Participante (simulación)", length(indices)),
fecha_propuesta = rep(as.character(Sys.Date()), length(indices)),
estado = rep("PENDIENTE_DE_APROBACION", length(indices))
)
}
# PASO 4. Bitácora para tres variables. Recuerde: aún no hay aprobación.
bitacora_propuesta <- dplyr::bind_rows(
registrar_cambios(personas_raw, personas_propuesta, "area", "N6-01"),
registrar_cambios(personas_raw, personas_propuesta, "sexo", "N6-02"),
registrar_cambios(personas_raw, personas_propuesta, "provincia", "N6-03")
)
print(head(bitacora_propuesta, 15))
bitacora_propuesta %>% count(variable, estado, name = "cambios_propuestos")
View(bitacora_propuesta)
# PASO 5. Verificar que las dimensiones se mantengan invariantes.
stopifnot(nrow(personas_raw) == nrow(personas_propuesta))
stopifnot(identical(personas_raw$id_persona, personas_propuesta$id_persona))
# PASO 6. Comparación gráfica antes/después de la etiqueta de área.
comp_area <- dplyr::bind_rows(
personas_raw %>% count(area, name = "total") %>% mutate(etapa = "Antes"),
personas_propuesta %>% count(area, name = "total") %>% mutate(etapa = "Propuesta")
)
ggplot(comp_area, aes(x = area, y = total, fill = etapa)) +
geom_col(position = "dodge") +
labs(title = "Normalización de etiquetas de área",
x = "Área registrada", y = "Registros") +
theme_minimal()
# SOLO si el instructor revisa, guardar en ruta distinta:
readr::write_csv(bitacora_propuesta, here::here("bitacora", "bitacora_propuesta.csv"), na = "NA")
view(bitacora_propuesta)
View(bitacora_propuesta)
source("D:/Repositorios/Inec/Clase4/R/00_preparacion.R", echo = TRUE)
source("D:/Repositorios/Inec/Clase4/R/06_01_normalizacion_bitacora_guiado.R", echo = TRUE)
source("D:/Repositorios/Inec/Clase4/R/05_01_consistencia_logica_guiado.R", echo = TRUE)
source("D:/Repositorios/Inec/Clase4/R/05_02_claves_integridad_guiado.R", echo = TRUE)
source("D:/Repositorios/Inec/Clase4/R/06_01_normalizacion_bitacora_guiado.R", echo = TRUE)
# ============================================================================
# MÓDULO 6.2 | MEDIA, MEDIANA E IMPUTACIÓN EN ESCENARIOS (NO AUTORIZADOS)
# Media: suma de valores observados / número de valores observados.
# Mediana: valor central de la serie ordenada; robusta frente a extremos.
# Imputación: sustitución estimada del faltante, con supuestos y sesgos.
# ============================================================================
source(here::here("R", "00_preparacion.R"))
View(personas)
# PASO 1. Confirmar que las cantidades están estandarizadas y que cero != NA.
personas %>% summarise(
ausencias = sum(is.na(ingreso_n)),
ceros = sum(ingreso_n == 0, na.rm = TRUE),
negativos = sum(ingreso_n < 0, na.rm = TRUE),
maximo = max(ingreso_n, na.rm = TRUE)
)
# PASO 2. Conjunto numérico válido para estimadores (filtro didáctico: >= 0).
# Negativos: se separan como 'requieren revisión', no se borran del origen.
ingresos_validos <- personas$ingreso_n[
!is.na(personas$ingreso_n) & personas$ingreso_n >= 0
]
media_global <- mean(ingresos_validos)
mediana_global <- median(ingresos_validos)
media_sensibilidad <- mean(ingresos_validos[ingresos_validos <= 3000])
cat("Media válida:", media_global, "\n")
cat("Mediana válida:", mediana_global, "\n")
cat("Media sin extremos >3000 (SOLO sensibilidad):", media_sensibilidad, "\n")
print(ingresos_validos)
# PASO 3. La mediana por condición de actividad puede ser distinta por grupo.
medianas_grupo <- personas %>%
filter(!is.na(condicion_actividad)) %>%
group_by(condicion_actividad) %>%
summarise(
mediana_grupo = median(ingreso_n[!is.na(ingreso_n) & ingreso_n >= 0],
na.rm = TRUE),
observados_validos = sum(!is.na(ingreso_n) & ingreso_n >= 0),
.groups = "drop"
)
print(medianas_grupo)
# PASO 4. Crear variables de ESCENARIO. Preservar negativos existentes para
# revisión; solo sustituir los NA. La variable ingreso_n NO se modifica.
escenarios <- personas %>%
left_join(medianas_grupo, by = "condicion_actividad") %>%
mutate(
imputacion_aplicada = is.na(ingreso_n),
ingreso_media_sim = if_else(is.na(ingreso_n), media_global, ingreso_n),
ingreso_mediana_sim = if_else(is.na(ingreso_n), mediana_global, ingreso_n),
ingreso_grupo_sim = if_else(is.na(ingreso_n),
coalesce(mediana_grupo, mediana_global), ingreso_n)
)
# PASO 5. Analizar el efecto SIN presentar los escenarios como datos medidos.
escenarios %>% summarise(
n_imputados = sum(imputacion_aplicada),
media_escenario = mean(ingreso_media_sim[ingreso_media_sim >= 0]),
mediana_escenario = median(ingreso_mediana_sim[ingreso_mediana_sim >= 0]),
media_grupo_escenario = mean(ingreso_grupo_sim[ingreso_grupo_sim >= 0])
)
# PASO 6. Visualizar el efecto de la distribución asimétrica.
resumen_estimadores <- tibble::tibble(
estimador = c("Media global", "Mediana global", "Media (<= 3000)"),
usd = c(media_global, mediana_global, media_sensibilidad)
)
ggplot(resumen_estimadores, aes(x = estimador, y = usd)) +
geom_col(fill = "#397E9C") +
geom_text(aes(label = round(usd, 2)), vjust = -0.3) +
labs(title = "Media y mediana: sensibilidad a extremos",
x = "Estimador", y = "USD") +
theme_minimal()
View(personas)
# ============================================================================
# MÓDULO 6.3 | MÉTRICAS AUDITABLES Y SEGUIMIENTO
# Completitud: casillas requeridas presentes / casillas requeridas evaluadas.
# Validez: pruebas de reglas satisfechas / pruebas de reglas aplicables.
# Unicidad: registros con clave personal no repetida / registros con clave.
# CADA indicador tiene su propio denominador: NO promediar porcentajes.
# ============================================================================
source(here::here("R", "00_preparacion.R"))
# PASO 1. Definir qué campos son requeridos en este escenario didáctico.
requeridas <- c("id_persona", "id_hogar", "provincia", "edad",
"fecha_levantamiento", "personas_hogar")
# PASO 2. Crear función con criterios y denominadores explícitos.
calcular_indicadores <- function(datos) {
# COMPLETITUD: 6 campos x número de registros.
n_requeridas <- length(requeridas) * nrow(datos)
n_presentes <- sum(vapply(requeridas, function(nombre) {
sum(!is.na(limpiar_ausencias(datos[[nombre]])))
}, integer(1)))
# VALIDEZ: 3 pruebas con distinto conjunto de registros aplicables:
# - provincia presente y en catálogo (módulo 4)
# - edad presente, entera y entre 0 y 110 (rango meramente didáctico)
# - ingreso presente, formato numérico y valor no negativo
catalogo <- readr::read_csv(here::here("diccionario", "catalogo_provincias_didactico.csv"),
show_col_types = FALSE)$provincia
prov <- limpiar_ausencias(datos$provincia)
edad <- limpiar_ausencias(datos$edad)
ingreso <- limpiar_ausencias(datos$ingreso_mensual_usd)
edad_num <- suppressWarnings(as.numeric(edad))
ingreso_num <- suppressWarnings(as.numeric(ingreso))
den_prov <- sum(!is.na(prov))
den_edad <- sum(!is.na(edad))
den_ing <- sum(!is.na(ingreso))
num_prov <- sum(!is.na(prov) & prov %in% catalogo)
num_edad <- sum(!is.na(edad) & grepl("^[0-9]{1,3}$", edad) &
!is.na(edad_num) & edad_num >= 0 & edad_num <= 110)
num_ing <- sum(!is.na(ingreso) &
grepl("^[0-9]+\\.[0-9]{2}$", ingreso) &
!is.na(ingreso_num) & ingreso_num >= 0)
# UNICIDAD: contar filas cuya clave aparece exactamente una vez.
ids <- limpiar_ausencias(datos$id_persona)
ids <- ids[!is.na(ids)]
n_ids <- length(ids)
n_ids_sin_repeticion <- sum(!duplicated(ids) & !duplicated(ids, fromLast = TRUE))
numeradores <- c(n_presentes, num_prov + num_edad + num_ing,
n_ids_sin_repeticion)
denominadores <- c(n_requeridas, den_prov + den_edad + den_ing, n_ids)
tibble::tibble(
indicador = c("Completitud", "Validez", "Unicidad"),
numerador = numeradores,
denominador = denominadores,
porcentaje = round(100 * ifelse(denominadores > 0,
numeradores / denominadores, NA_real_), 2)
)
}
# PASO 3. Línea base, ANTES de cualquier normalización.
indicadores_antes <- calcular_indicadores(personas_raw)
print(indicadores_antes)
# PASO 4. ESCENARIO de normalización controlada, no producto autorizado.
source(here::here("R", "06_01_normalizacion_bitacora_guiado.R"))
indicadores_propuestos <- calcular_indicadores(personas_propuesta)
print(indicadores_propuestos)
print(indicadores_antes)
# PASO 5. Comparar sin atribuir causalidad ni aprobar datos.
comparativa <- dplyr::bind_rows(
indicadores_antes %>% mutate(escenario = "Antes"),
indicadores_propuestos %>% mutate(escenario = "Propuesta")
)
ggplot(comparativa, aes(x = indicador, y = porcentaje, fill = escenario)) +
geom_col(position = "dodge") +
geom_text(aes(label = paste0(porcentaje, "%")),
position = position_dodge(width = 0.9), vjust = -0.25, size = 3) +
coord_cartesian(ylim = c(0, 110)) +
labs(title = "Métricas de calidad por escenario (didáctico)",
x = "Indicador", y = "Porcentaje") +
theme_minimal()
# PASO 2: verificar que no falte ninguno de los objetos necesarios.
objetos_necesarios <- c(
"personas_raw", "personas_propuesta", "alertas_logicas",
"alertas_integridad", "bitacora_propuesta", "indicadores_antes",
"indicadores_propuestos"
)
# PASO 2: verificar que no falte ninguno de los objetos necesarios.
objetos_necesarios <- c(
"personas_raw", "personas_propuesta", "alertas_logicas",
"alertas_integridad", "bitacora_propuesta", "indicadores_antes",
"indicadores_propuestos"
)
objetos_faltantes <- objetos_necesarios[
!vapply(objetos_necesarios, exists, logical(1), envir = .GlobalEnv,
inherits = FALSE)
]
if (length(objetos_faltantes) > 0L) {
stop(paste("Faltan resultados de los módulos 5 y 6:",
paste(objetos_faltantes, collapse = ", "),
"Ejecute los scripts previos antes de guardar el punto de control."))
}
# PASO 3: verificar que ambas versiones tengan igual número de filas.
stopifnot(nrow(personas_raw) == nrow(personas_propuesta))
stopifnot(identical(as.character(personas_raw$id_persona),
as.character(personas_propuesta$id_persona)))
# PASO 4: convertir los objetos existentes en una lista con nombre.
# Una lista permite guardar múltiples data frames en un único archivo RDS.
hitos <- list(
personas_raw = personas_raw,
personas_propuesta = personas_propuesta,
alertas_logicas = alertas_logicas,
alertas_integridad = alertas_integridad,
bitacora_propuesta = bitacora_propuesta,
indicadores_antes = indicadores_antes,
indicadores_propuestos = indicadores_propuestos,
metadata = list(
origen = "personas_encuesta_sintetica_2026_10.csv",
fecha_punto_control = Sys.time(),
interpretacion = "Datos sintéticos; propuesta pendiente de aprobación",
version_modulo = "5-6/1.0"
)
)
View(hitos)
# PASO 5: crear carpeta de resultados y guardar el objeto.
ruta_salida <- here::here("resultados", "01_hitos_modulos_5_6.rds")
dir.create(dirname(ruta_salida), showWarnings = FALSE, recursive = TRUE)
saveRDS(hitos, ruta_salida)  # serializa los objetos conservando tipos y NA
# PASO 6: verificar que el archivo guardado se puede recuperar.
comprobacion <- readRDS(ruta_salida)
stopifnot(nrow(comprobacion$personas_raw) == nrow(personas_raw))
cat("Punto de control guardado en:", ruta_salida, "\n")
cat("Registros originales:", nrow(comprobacion$personas_raw), "\n")
cat("Alertas lógicas:", nrow(comprobacion$alertas_logicas), "\n")
cat("Alertas de integridad:", nrow(comprobacion$alertas_integridad), "\n")
normalizar_ausencia <- function(x) {
# trimws() elimina espacios de extremos; toupper() uniformiza mayúsculas.
y <- trimws(as.character(x))
y[is.na(y) | toupper(y) %in% c("", "NA", "N/D", "SIN DATO")] <- NA_character_
y
}
validar_hitos <- function(hitos) {
# stopifnot() detiene el análisis ante un punto de control incompleto.
necesarios <- c("personas_raw", "personas_propuesta", "alertas_logicas",
"alertas_integridad", "bitacora_propuesta",
"indicadores_antes", "indicadores_propuestos")
ausentes <- setdiff(necesarios, names(hitos))
if (length(ausentes)) stop("Faltan objetos en el RDS: ", paste(ausentes, collapse=", "))
if (nrow(hitos$personas_raw) != nrow(hitos$personas_propuesta)) {
stop("Las versiones original y propuesta tienen distinta cantidad de filas")
}
columnas_alerta <- c("fila_csv", "regla_id", "severidad")
for (nm in c("alertas_logicas", "alertas_integridad")) {
if (!all(columnas_alerta %in% names(hitos[[nm]]))) {
stop("La tabla ", nm, " no tiene todas las columnas esperadas")
}
}
for (nm in c("indicadores_antes", "indicadores_propuestos")) {
if (!all(c("indicador", "numerador", "denominador", "porcentaje") %in%
names(hitos[[nm]]))) stop("Estructura incorrecta en: ", nm)
}
invisible(TRUE)
}
# MISMA DEFINICIÓN DIDÁCTICA DEL MÓDULO 6.
# Se utiliza únicamente cuando llega un SEGUNDO ARCHIVO o un período distinto.
# El cálculo principal se toma de los indicadores ya producidos en el módulo 6.
calcular_indicadores_compatibles <- function(datos, catalogo_provincias) {
requeridas <- c("id_persona", "id_hogar", "provincia", "edad",
"fecha_levantamiento", "personas_hogar")
faltantes <- setdiff(c(requeridas, "ingreso_mensual_usd"), names(datos))
if (length(faltantes)) stop("Columnas faltantes: ", paste(faltantes, collapse = ", "))
# Completitud: presencia de los seis campos exigidos para la práctica.
den_comp <- length(requeridas) * nrow(datos)
num_comp <- sum(vapply(requeridas, function(nm) {
sum(!is.na(normalizar_ausencia(datos[[nm]])))
}, integer(1)))
# Validez: cantidad de pruebas superadas / cantidad de pruebas aplicables.
prov <- normalizar_ausencia(datos$provincia)
edad <- normalizar_ausencia(datos$edad)
ing  <- normalizar_ausencia(datos$ingreso_mensual_usd)
edad_num <- suppressWarnings(as.numeric(edad))
ing_num <- suppressWarnings(as.numeric(ing))
den_val <- sum(!is.na(prov)) + sum(!is.na(edad)) + sum(!is.na(ing))
num_val <- sum(!is.na(prov) & prov %in% catalogo_provincias) +
sum(!is.na(edad) & grepl("^[0-9]{1,3}$", edad) &
!is.na(edad_num) & edad_num >= 0 & edad_num <= 110) +
sum(!is.na(ing) & grepl("^[0-9]+\\.[0-9]{2}$", ing) &
!is.na(ing_num) & ing_num >= 0)
# Unicidad: solo IDs de persona declarados; repetición desde ambos extremos.
ids <- normalizar_ausencia(datos$id_persona)
ids <- ids[!is.na(ids)]
den_uni <- length(ids)
num_uni <- sum(!duplicated(ids) & !duplicated(ids, fromLast = TRUE))
numeradores <- c(num_comp, num_val, num_uni)
denominadores <- c(den_comp, den_val, den_uni)
tibble::tibble(
indicador = c("Completitud", "Validez", "Unicidad"),
numerador = numeradores,
denominador = denominadores,
porcentaje = round(100 * ifelse(denominadores > 0,
numeradores / denominadores, NA_real_), 2)
)
}
construir_analisis <- function(hitos) {
validar_hitos(hitos)
# bind_rows() mantiene los indicadores de cada escenario en una tabla larga.
indicadores_long <- dplyr::bind_rows(
dplyr::mutate(hitos$indicadores_antes, escenario = "Original"),
dplyr::mutate(hitos$indicadores_propuestos, escenario = "Propuesta")
)
if (any(duplicated(indicadores_long[c("indicador", "escenario")]))) {
stop("Un mismo indicador aparece dos veces en un escenario")
}
if (any(indicadores_long$numerador > indicadores_long$denominador,
na.rm = TRUE)) stop("Un numerador supera su denominador")
# pivot_wider() convierte filas por escenario en columnas comparables.
indicadores_ancho <- indicadores_long |>
tidyr::pivot_wider(
id_cols = "indicador", names_from = "escenario",
values_from = c("numerador", "denominador", "porcentaje"),
names_glue = "{.value}_{escenario}"
) |>
dplyr::mutate(variacion_pp = porcentaje_Propuesta - porcentaje_Original)
# Incidencias de los módulos 5.1 y 5.2: una fila por regla y severidad.
incidencias <- dplyr::bind_rows(
hitos$alertas_logicas |>
dplyr::count(regla_id, severidad, name = "incidencias") |>
dplyr::mutate(origen = "Consistencia lógica"),
hitos$alertas_integridad |>
dplyr::count(regla_id, severidad, name = "incidencias") |>
dplyr::mutate(origen = "Integridad")
) |>
dplyr::select(origen, regla_id, severidad, incidencias) |>
dplyr::arrange(origen, regla_id)
# Distinción: cantidad de eventos no equivale a cantidad de filas afectadas.
filas_alertadas <- union(
hitos$alertas_logicas$fila_csv, hitos$alertas_integridad$fila_csv
)
filas_alertadas <- unique(filas_alertadas[!is.na(filas_alertadas)])
n_filas <- nrow(hitos$personas_raw)
cobertura_alertas <- tibble::tibble(
medida = c("Eventos de alerta", "Filas con al menos una alerta", "Filas del CSV"),
total = c(nrow(hitos$alertas_logicas) + nrow(hitos$alertas_integridad),
length(filas_alertadas), n_filas)
)
porcentaje_filas_alertadas <- if (n_filas > 0) round(100 * length(filas_alertadas) / n_filas, 2) else NA_real_
requeridas <- c("id_persona", "id_hogar", "provincia", "edad",
"fecha_levantamiento", "personas_hogar")
# vapply() devuelve un entero por columna de forma controlada.
faltantes <- tibble::tibble(
variable = requeridas,
ausencias = vapply(requeridas, function(nm) {
sum(is.na(normalizar_ausencia(hitos$personas_raw[[nm]])))
}, integer(1)),
evaluados = n_filas
) |>
dplyr::mutate(porcentaje = round(100 * ausencias / evaluados, 2))
# Resumen estadístico DESCRIPTIVO de campos numéricos. Se excluyen
# formatos no convertibles y valores fuera de dominio didáctico para estas
# estadísticas; permanecen intactos en los datos de origen y en alertas.
# Los ingresos altos no se eliminan solo por ser atípicos.
resumen_numericos <- dplyr::bind_rows(lapply(
c("edad", "ingreso_mensual_usd"), function(campo) {
texto <- normalizar_ausencia(hitos$personas_raw[[campo]])
x <- suppressWarnings(as.numeric(texto))
admitido <- !is.na(x) & x >= 0
if (campo == "edad") admitido <- admitido & x <= 110 & x == floor(x)
aceptados <- x[admitido]
tibble::tibble(
variable = campo,
ausencias_declaradas = sum(is.na(texto)),
no_convertibles = sum(!is.na(texto) & is.na(x)),
fuera_dominio = sum(!is.na(x) & !admitido),
validos_estadisticos = length(aceptados),
ceros = sum(aceptados == 0),
media = if (length(aceptados)) round(mean(aceptados), 2) else NA_real_,
mediana = if (length(aceptados)) round(median(aceptados), 2) else NA_real_,
q1 = if (length(aceptados)) round(as.numeric(quantile(aceptados, 0.25)), 2) else NA_real_,
q3 = if (length(aceptados)) round(as.numeric(quantile(aceptados, 0.75)), 2) else NA_real_,
maximo = if (length(aceptados)) max(aceptados) else NA_real_
)
}
))
bitacora_resumen <- hitos$bitacora_propuesta |>
dplyr::count(variable, estado, name = "cambios_propuestos") |>
dplyr::arrange(dplyr::desc(cambios_propuestos))
periodos <- hitos$personas_raw |>
dplyr::count(periodo_referencia, name = "filas") |>
dplyr::mutate(
formato_aaaa_mm = !is.na(periodo_referencia) &
grepl("^[0-9]{4}-(0[1-9]|1[0-2])$", periodo_referencia),
interpretacion = ifelse(formato_aaaa_mm, "Formato esperado", "Revisar formato")
)
list(
metadata = list(fecha_analisis = Sys.time(), n_registros = n_filas,
nota = "Simulación. Propuesta no autorizada.",
porcentaje_filas_alertadas = porcentaje_filas_alertadas),
indicadores_long = indicadores_long,
indicadores_ancho = indicadores_ancho,
incidencias = incidencias,
cobertura_alertas = cobertura_alertas,
faltantes = faltantes,
resumen_numericos = resumen_numericos,
bitacora_resumen = bitacora_resumen,
periodos = periodos
)
}
# PASO 1. Cargar paquetes y funciones (las funciones se definen, NO se ejecutan).
library(here)
library(dplyr)
library(tidyr)
library(readr)
source(here::here("R", "07_00_funciones_analisis.R"))
# PASO 2. Recuperar las tablas guardadas al terminar los módulos 5 y 6.
ruta_hitos <- here::here("resultados", "01_hitos_modulos_5_6.rds")
if (!file.exists(ruta_hitos)) {
stop("Primero ejecute R/06_99_guardar_hitos_para_reporte.R")
}
hitos <- readRDS(ruta_hitos)  # RDS conserva valores NA y tipos de datos.
View(hitos)
# PASO 3. Construir análisis, sin volver a ejecutar los módulos 5 y 6.
analisis <- construir_analisis(hitos)
View(analisis)
# PASO 4. Revisar indicadores, incidencia y ausencias antes de exportar.
print(analisis$indicadores_ancho)
View(analisis$indicadores_ancho)
print(analisis$incidencias)
View(analisis$incidencias)
View(analisis$cobertura_alertas)
View(analisis$periodos)
# PASO 5. Crear carpeta y exportar tablas derivadas (nunca 'data_raw').
ruta_tablas <- here::here("resultados", "tablas")
dir.create(ruta_tablas, showWarnings = FALSE, recursive = TRUE)
readr::write_csv(analisis$indicadores_ancho,
file.path(ruta_tablas, "07_indicadores_escenarios.csv"), na = "NA")
readr::write_csv(analisis$incidencias,
file.path(ruta_tablas, "07_alertas_por_regla.csv"), na = "NA")
readr::write_csv(analisis$faltantes,
file.path(ruta_tablas, "07_ausencias_campos.csv"), na = "NA")
readr::write_csv(analisis$resumen_numericos,
file.path(ruta_tablas, "07_estadisticos_descriptivos.csv"), na = "NA")
readr::write_csv(analisis$bitacora_resumen,
file.path(ruta_tablas, "07_resumen_bitacora.csv"), na = "NA")
readr::write_csv(analisis$periodos,
file.path(ruta_tablas, "07_calidad_formato_periodo.csv"), na = "NA")
# PASO 6. Guardar además un RDS para que Quarto use tipos originales.
saveRDS(analisis, here::here("resultados", "02_analisis_modulo_7.rds"))
cat("Tablas guardadas en:", ruta_tablas, "\n")
# =============================================================================
# MÓDULO 7.2 | GRÁFICOS PARA VISUALIZAR E INTERPRETAR LA CALIDAD
# PRERREQUISITO: 07_01_tablas_calidad.R (02_analisis_modulo_7.rds)
# OBJETIVO: representar datos calculados; no inventar nuevos recuentos.
# =============================================================================
library(here)
library(dplyr)
library(ggplot2)
ruta_resumen <- here::here("resultados", "02_analisis_modulo_7.rds")
if (!file.exists(ruta_resumen)) stop("Ejecute antes 07_01_tablas_calidad.R")
a <- readRDS(ruta_resumen)
carpeta_figuras <- here::here("resultados", "figuras")
dir.create(carpeta_figuras, recursive = TRUE, showWarnings = FALSE)
# GRÁFICO 1. Barras agrupadas: tres indicadores en dos escenarios.
# geom_col() usa el valor de porcentaje existente; position_dodge() separa barras.
g_indicadores <- ggplot(a$indicadores_long,
aes(x = indicador, y = porcentaje, fill = escenario)) +
geom_col(position = position_dodge(width = 0.75), width = 0.65) +
geom_text(aes(label = paste0(format(porcentaje, decimal.mark=",", nsmall=2), "%")),
position = position_dodge(width = 0.75), vjust = -0.25, size = 3) +
coord_cartesian(ylim = c(0, 105)) +
labs(title = "Indicadores de calidad: original y propuesta",
subtitle = "Escenarios didácticos; la propuesta no constituye aprobación",
x = NULL, y = "Porcentaje de evaluaciones", fill = "Escenario") +
theme_minimal(base_size = 11)
print(g_indicadores)
ggsave(file.path(carpeta_figuras, "07_indicadores_escenarios.png"),
plot = g_indicadores, width = 9, height = 5.5, dpi = 170)
# GRÁFICO 2. Eventos por regla, separados según su procedencia.
g_alertas <- ggplot(a$incidencias,
aes(x = reorder(regla_id, incidencias), y = incidencias,
fill = origen)) +
geom_col() + coord_flip() +
labs(title = "Número de alertas por regla", x = "Código de regla",
y = "Eventos de alerta", fill = "Origen") +
theme_minimal(base_size = 11)
print(g_alertas)
ggsave(file.path(carpeta_figuras, "07_alertas_por_regla.png"),
plot = g_alertas, width = 9, height = 5.5, dpi = 170)
# GRÁFICO 3. Número de ausencias de los seis campos declarados obligatorios.
g_ausencias <- ggplot(a$faltantes,
aes(x = reorder(variable, ausencias), y = ausencias)) +
geom_col(fill = "#2476A3") + coord_flip() +
geom_text(aes(label = ausencias), hjust = -0.12, size = 3) +
labs(title = "Ausencias en campos requeridos", x = NULL,
y = "Número de celdas ausentes") +
theme_minimal(base_size = 11)
print(g_ausencias)
ggsave(file.path(carpeta_figuras, "07_ausencias_campos.png"),
plot = g_ausencias, width = 9, height = 5.5, dpi = 170)
# VERIFICACIÓN: listar imágenes realmente generadas.
list.files(carpeta_figuras, pattern = "^07_.*\\.png$", full.names = TRUE)
quarto --version
install.packages("quarto")
quarto --version
quarto::quarto_version()
quarto check
system("quarto check")
system("quarto --version")
install.packages("quarto")
install.packages("pkbuild")
